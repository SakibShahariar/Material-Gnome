# Base colors using dark MD3 scheme
color-link default "{{colors.on_background.default.hex}}"
color-link comment "{{colors.outline.default.hex}}"

# Identifiers - using primary colors
color-link identifier "{{colors.primary.default.hex}}"
color-link identifier.class "{{colors.primary_container.default.hex}}"
color-link identifier.var "{{colors.primary.default.hex}}"

# Constants - using surface variants
color-link constant "{{colors.on_secondary_container.default.hex}}"
color-link constant.string "{{colors.on_background.default.hex}}"

# Symbols and statements - using secondary colors
color-link symbol "{{colors.secondary.default.hex}}"
color-link statement "{{colors.primary.default.hex}}"

# Types - using tertiary colors
color-link type "{{colors.on_background.default.hex}}"
color-link type.keyword "{{colors.tertiary.default.hex}}"

# Special and preprocessor
color-link special "{{colors.on_background.default.hex}}"
color-link preproc "{{colors.on_surface_variant.default.hex}}"

# UI Elements
color-link underlined "{{colors.primary.default.hex}}"
color-link error "bold {{colors.error.default.hex}}"
color-link todo "bold {{colors.primary.default.hex}}"

# Diff colors
color-link diff-added "{{colors.tertiary.default.hex}}"
color-link diff-modified "{{colors.primary_container.default.hex}}"
color-link diff-deleted "{{colors.error.default.hex}}"

# Gutter and line numbers
color-link gutter-error "{{colors.error.default.hex}}"
color-link gutter-warning "{{colors.on_background.default.hex}}"
color-link line-number "{{colors.outline.default.hex}}"
color-link current-line-number "{{colors.primary.default.hex}}"
color-link indent-char "{{colors.outline.default.hex}}"

# Interface colors (using your dark surfaces)
color-link cursor-line "{{colors.surface_container_high.default.hex}},{{colors.on_background.default.hex}}"
color-link color-column "{{colors.surface_container_high.default.hex}}"
color-link statusline "{{colors.on_background.default.hex}}"
color-link tabbar "{{colors.surface.default.hex}},{{colors.surface_container_highest.default.hex}}"

# Search and matching
color-link hlsearch "{{colors.on_background.default.hex}}"
color-link match-brace "{{colors.primary.default.hex}},{{colors.surface.default.hex}}"

# Whitespace and errors
color-link tab-error "{{colors.error.default.hex}}"
color-link trailingws "{{colors.error.default.hex}}"

# Background and selection
color-link background "{{colors.background.default.hex}}"
color-link selected "{{colors.surface_container_highest.default.hex}}"
