color-link default "#c0caf5"
color-link comment "#565f89"

color-link identifier "#7aa2f7"
color-link identifier.class "#89b4fa"
color-link identifier.var "#89b4fa"

color-link constant "#3f503e"
color-link constant.string "#6c5dd3"

color-link symbol "#7aa2f7"

color-link type "#33467c"
color-link type.keyword "#f9e2af"

color-link special "#6c5dd3"
color-link statement "#7aa2f7"
color-link preproc "#a9b1d6"

color-link underlined "#7aa2f7"
color-link error "bold #f7768e"
color-link todo "bold #7aa2f7"

color-link diff-added "#bb9af7"
color-link diff-modified "#7aa2f7"
color-link diff-deleted "#f7768e"

color-link gutter-error "#f7768e"
color-link gutter-warning "#33467c"

color-link statusline "#4b366b"
color-link tabbar "#1a1b26,#c0caf5"
color-link indent-char "#414868"
color-link line-number "#414868"
color-link current-line-number "#7aa2f7"

color-link cursor-line "#35384d,#cdd6f4"
color-link color-column "#35384d"
color-link type.extended "default"

color-link hlsearch "#000000"

color-link match-brace "#7aa2f7,#33467c"

color-link tab-error "#f7768e"
color-link trailingws "#f7768e"
