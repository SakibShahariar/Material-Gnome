# Matugen template for btop - Tokyo Night

# Main background
theme[main_bg]=""

# Main text color
theme[main_fg]="#C0CAF5"  # on_surface

# Title color for boxes
theme[title]="#7AA2F7"    # primary

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9ECE6A"    # secondary

# Background color of selected item in processes box
theme[selected_bg]="#7AA2F7"

# Foreground color of selected item in processes box
theme[selected_fg]="#1E2A47"  # on_primary

# Color of inactive/disabled text
theme[inactive_fg]="#A9B1D6"  # on_surface_variant

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#BB9AF7"   # tertiary

# CPU box outline color
theme[cpu_box]="#565F89"     # outline

# Memory/disks box outline color
theme[mem_box]="#565F89"     # outline

# Net up/down box outline color
theme[net_box]="#565F89"     # outline

# Processes box outline color
theme[proc_box]="#565F89"    # outline

# Box divider line and small boxes line color
theme[div_line]="#414868"    # outline_variant

# Temperature graph colors
theme[temp_start]="#9ECE6A"  # secondary
theme[temp_mid]="#7AA2F7"    # primary
theme[temp_end]="#F7768E"    # error

# CPU graph colors
theme[cpu_start]="#9ECE6A"
theme[cpu_mid]="#7AA2F7"
theme[cpu_end]="#F7768E"

# Mem/Disk free meter
theme[free_start]="#9ECE6A"
theme[free_mid]=""
theme[free_end]="#3F503E"   # secondary_container

# Mem/Disk cached meter
theme[cached_start]="#BB9AF7"
theme[cached_mid]=""
theme[cached_end]="#4B366B" # tertiary_container

# Mem/Disk available meter
theme[available_start]="#7AA2F7"
theme[available_mid]=""
theme[available_end]="#33467C" # primary_container

# Mem/Disk used meter
theme[used_start]="#F7768E"
theme[used_mid]=""
theme[used_end]="#813747"    # error_container

# Download graph colors
theme[download_start]="#9ECE6A"
theme[download_mid]="#7AA2F7"
theme[download_end]="#BB9AF7"

# Upload graph colors
theme[upload_start]="#9ECE6A"
theme[upload_mid]="#7AA2F7"
theme[upload_end]="#BB9AF7"
