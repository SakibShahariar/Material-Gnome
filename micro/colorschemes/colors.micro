color-link default "#e8e2d5"
color-link comment "#959181"

color-link identifier "#695f11"
color-link identifier.class "#89b4fa"
color-link identifier.var "#89b4fa"

color-link constant "#ebe3bd"
color-link constant.string "#c3ecd2"

color-link symbol "#d6c871"

color-link type "#f3e489"
color-link type.keyword "#f9e2af"

color-link special "#c3ecd2"
color-link statement "#d6c871"
color-link preproc "#ccc6b5"

color-link underlined "#695f11"
color-link error "bold #ffb4ab"
color-link todo "bold #695f11"

color-link diff-added "#a7d0b6"
color-link diff-modified "#695f11"
color-link diff-deleted "#ffb4ab"

color-link gutter-error "#ffb4ab"
color-link gutter-warning "##f3e489"

color-link statusline "#c3ecd2"
color-link tabbar "#15130c,#e8e2d5"
color-link indent-char "#4a4739"
color-link line-number "#4a4739"
color-link current-line-number "#d6c871"

color-link cursor-line "#2c2a21,#cdd6f4"
color-link color-column "#2c2a21"
color-link type.extended "default"

color-link hlsearch "#000000"

color-link match-brace "#d6c871,#f3e489"

color-link tab-error "#ffb4ab"
color-link trailingws "#ffb4ab"
