# Base colors using dark MD3 scheme
color-link default "#e3e3d9"
color-link comment "#8e9383"

# Identifiers - using primary colors
color-link identifier "#b0d27b"
color-link identifier.class "#7b9b4a"
color-link identifier.var "#b0d27b"

# Constants - using surface variants
color-link constant "#dbeabe"
color-link constant.string "#e3e3d9"

# Symbols and statements - using secondary colors
color-link symbol "#bdcca2"
color-link statement "#b0d27b"

# Types - using tertiary colors
color-link type "#e3e3d9"
color-link type.keyword "#faaeec"

# Special and preprocessor
color-link special "#e3e3d9"
color-link preproc "#c4c8b7"

# UI Elements
color-link underlined "#b0d27b"
color-link error "bold #ffb4ab"
color-link todo "bold #b0d27b"

# Diff colors
color-link diff-added "#faaeec"
color-link diff-modified "#7b9b4a"
color-link diff-deleted "#ffb4ab"

# Gutter and line numbers
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e3e3d9"
color-link line-number "#8e9383"
color-link current-line-number "#b0d27b"
color-link indent-char "#8e9383"

# Interface colors (using your dark surfaces)
color-link cursor-line "#292b24,#e3e3d9"
color-link color-column "#292b24"
color-link statusline "#e3e3d9"
color-link tabbar "#12140e,#34362f"

# Search and matching
color-link hlsearch "#e3e3d9"
color-link match-brace "#b0d27b,#12140e"

# Whitespace and errors
color-link tab-error "#ffb4ab"
color-link trailingws "#ffb4ab"

# Background and selection
color-link background "#12140e"
color-link selected "#34362f"
